{
  "name": "canvash",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm dev:vanilla",
    "dev:vanilla": "pnpm --filter @canvash/example-vanilla dev",
    "dev:react": "pnpm --filter @canvash/example-react dev",
    "dev:vue": "pnpm --filter @canvash/example-vue dev",
    "dev:wc": "pnpm --filter @canvash/example-web-components dev",
    "dev:examples": "pnpm --parallel --filter \"./examples/*\" dev",
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:examples": "pnpm --filter \"./examples/*\" run build",
    "typecheck": "node scripts/tsconfig-guard.mjs && tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:changed": "node scripts/test-changed.mjs",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:packaging": "vitest run --config tests/packaging/vitest.config.ts",
    "version:set": "node scripts/set-version.mjs",
    "publish:local": "node scripts/publish-local.mjs",
    "test:e2e": "playwright test tests/e2e",
    "benchmark": "node scripts/run-benchmark.mjs",
    "benchmark:ink": "node scripts/run-benchmark.mjs --ink",
    "benchmark:labels": "node scripts/run-benchmark.mjs --labels",
    "benchmark:boards": "node scripts/run-benchmark.mjs --boards",
    "benchmark:grid": "node scripts/run-benchmark.mjs --grid",
    "benchmark:highlight": "node scripts/run-benchmark.mjs --highlight",
    "benchmark:peers": "node scripts/benchmark-peers.mjs",
    "check:secrets": "gitleaks dir . --redact --no-banner",
    "check:floor": "node scripts/floor-guard.mjs",
    "check:names": "node scripts/legacy-names-guard.mjs",
    "check:arch": "depcruise . --config .dependency-cruiser.cjs",
    "check:diff-coverage": "node scripts/check-diff-coverage.mjs",
    "check:sast": "semgrep scan --config p/default --config p/owasp-top-ten --error --quiet .",
    "check:deps": "node scripts/check-deps.mjs",
    "check:a11y": "playwright test tests/e2e/web-components/a11y.spec.ts",
    "check:fast": "node scripts/check-fast.mjs",
    "check:task": "pnpm check:fast && pnpm typecheck && pnpm check:arch && pnpm test:changed && pnpm check:diff-coverage",
    "check:full": "pnpm check:fast && pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:arch && pnpm test:coverage && pnpm check:diff-coverage && pnpm test:packaging && pnpm check:sast && pnpm check:deps && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unbuild": "^3.6.1",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "vue": "^3.5.43"
  }
}
