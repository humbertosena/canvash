{
  // Código de web-components. Herda opções estritas de tsconfig.base.json e habilita DOM.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
