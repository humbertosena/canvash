{
  "name": "@canvash/react",
  "version": "0.1.0-alpha",
  "license": "MIT",
  "description": "Componentes e hooks React para o Canvash.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ssr": "./src/ssr.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./ssr": {
        "import": {
          "types": "./dist/ssr.d.mts",
          "default": "./dist/ssr.mjs"
        },
        "require": {
          "types": "./dist/ssr.d.cts",
          "default": "./dist/ssr.cjs"
        }
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@canvash/core": "workspace:*",
    "@canvash/web-components": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "build": "unbuild",
    "prepack": "pnpm run build"
  }
}
